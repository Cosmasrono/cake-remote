generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String   @unique
  password  String
  role      UserRole   @default(USER)
  isActive  Boolean    @default(true)
  deletedAt DateTime?
  sessionVersion Int  @default(0)
  pin       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  Enrollment Enrollment[]
  payments   Payment[]
  cartItems  Cart[]
  posSales   PosSale[]
}

enum UserRole {
  USER
  CASHIER
  ADMIN
  SUPER_ADMIN
}

model Cake {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  type      String
  price     Float
  image     String
  rating    Int      @default(5)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Cart {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  cakeName  String
  cakeType  String
  price     Float
  image     String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
}

model Order {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  cakeName  String
  cakeType  String
  createdAt DateTime @default(now())
}

model Course {
  id           String       @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  description  String
  level        String
  price        Float
  image        String?
  whatsappLink String?      // Add this line
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  enrollments  Enrollment[]
}

enum EnrollmentStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

model Enrollment {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  userId      String           @db.ObjectId
  user        User             @relation(fields: [userId], references: [id])
  courseId    String           @db.ObjectId
  course      Course           @relation(fields: [courseId], references: [id])
  phoneNumber String?
  status      EnrollmentStatus @default(PENDING)
  enrolledAt  DateTime         @default(now())
  paymentInfo String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Payment {
  id                  String        @id @default(auto()) @map("_id") @db.ObjectId
  userId              String        @db.ObjectId // Add userId field
  user                User          @relation(fields: [userId], references: [id]) // Establish relation to User model
  merchantRequestId   String
  checkoutRequestId   String        @unique
  phoneNumber         String
  amount              Float
  status              PaymentStatus @default(PENDING)
  resultCode          Int?
  resultDesc          String?
  mpesaReceiptNumber  String?
  transactionDate     String?
  cartItems           Json?         // Store cart items
  // Where a website order is in the kitchen/delivery process (null = new).
  // NEW | PREPARING | OUT_FOR_DELIVERY | READY | DELIVERED | COLLECTED | CANCELLED
  fulfilment          String?
  fulfilmentLog       Json?         // [{ stage, at, by }]
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}


model CustomOrder {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  phone           String
  occasion        String?
  date            String?
  flavor          String?
  size            String?
  message         String?
  inspirationLink String?
  image           String?
  deliveryMethod  String?  // "pickup" | "delivery" (older enquiries: not set = pickup)
  deliveryAddress String?
  source          String?
  status          String   @default("pending")
  createdAt       DateTime @default(now())

  @@map("custom_orders")
}


model Promotion {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  message   String
  active    Boolean  @default(true)
  
  // Day-based scheduling (0 = Sunday, 6 = Saturday)
  daysOfWeek Int[]   @default([]) // e.g., [0,1,2,3,4,5,6] for all days, [1,3,5] for Mon/Wed/Fri
  
  // Optional: Date range for seasonal promotions
  startDate  DateTime? // Optional start date
  endDate    DateTime? // Optional end date
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("promotions")
}

model PosSale {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  saleNumber    String   @unique
  cashierId     String   @db.ObjectId
  cashier       User     @relation(fields: [cashierId], references: [id])
  cashierName   String
  items         Json     // Array of { id, name, category, price, quantity, subtotal }
  subtotal      Float
  discount      Float    @default(0)
  total         Float
  paymentMethod String   // "CASH" | "MPESA"
  amountPaid    Float
  changeDue     Float    @default(0)
  mpesaCode     String?  // M-Pesa transaction code / receipt (e.g. QK84...)
  customerName  String?
  customerPhone String?
  notes         String?
  status        String   @default("COMPLETED") // "COMPLETED", "VOIDED"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("pos_sales")
}

// An M-Pesa prompt sent from the till. The ticket waits here until PayHero
// confirms the payment; only then is it recorded as a PosSale.
model PosMpesaRequest {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  reference    String?  // PayHero's reference for the STK push
  cashierId    String   @db.ObjectId
  cashierName  String
  phone        String
  amount       Float
  sale         Json     // the priced ticket (PreparedSale)
  status       String   @default("PENDING") // PENDING | COMPLETING | COMPLETED | FAILED
  saleNumber   String?
  mpesaReceipt String?
  resultDesc   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("pos_mpesa_requests")
}

model Expense {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  date           DateTime // The day the money was spent (midnight, Kenya time)
  amount         Float
  category       String   // One of EXPENSE_CATEGORIES in app/lib/expenses.ts
  description    String
  vendor         String?
  paymentMethod  String   // "CASH" | "MPESA" | "BANK" | "OTHER"
  reference      String?  // Receipt number or M-Pesa code
  recordedById   String   @db.ObjectId
  recordedByName String
  createdAt      DateTime @default(now())

  @@index([date])
  @@map("expenses")
}
